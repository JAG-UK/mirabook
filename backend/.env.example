# --- Mirabook backend configuration ---
# Copy to .env and adjust. All vars are prefixed MIRABOOK_.

# Which translation provider to use: ollama | anthropic | openai
MIRABOOK_PROVIDER=ollama

# Languages (the source is what the book is written in)
MIRABOOK_SOURCE_LANG=Spanish
MIRABOOK_TARGET_LANG=English

# Where uploaded books, extracted images, and the SQLite cache live
MIRABOOK_DATA_DIR=./data

# --- Ollama (default / local + capable-hardware path) ---
# Dev default is the small, fast translategemma:4b.
# On a capable GPU (e.g. RTX 5090, 32GB) use a strong general model that does
# BOTH translation and the grammar/idiom/alternatives features well, e.g.
# gemma4:31b (dense) or gemma4:26b (mixture-of-experts — much faster per block).
# Ollama auto-detects the GPU — no code/config changes needed
# beyond pointing at it. For remote access run Ollama with OLLAMA_HOST=0.0.0.0.
MIRABOOK_OLLAMA_HOST=http://localhost:11434
MIRABOOK_OLLAMA_MODEL=translategemma:4b
# Parallel block translations. Raise on a big GPU (pair with the server's
# OLLAMA_NUM_PARALLEL) to speed up page loads and offline downloads.
MIRABOOK_OLLAMA_CONCURRENCY=4
MIRABOOK_OLLAMA_TIMEOUT=180

# --- Production / serving over the internet (see scripts/serve.sh) ---
# Serve the built SPA from the backend too, so one port hosts app + API.
# MIRABOOK_STATIC_DIR=../frontend/dist
# Require HTTP Basic auth on every route — STRONGLY recommended for public URLs.
# MIRABOOK_BASIC_AUTH=reader:choose-a-strong-password

# --- Anthropic (optional, only read when PROVIDER=anthropic) ---
# MIRABOOK_ANTHROPIC_API_KEY=sk-ant-...
MIRABOOK_ANTHROPIC_MODEL=claude-opus-5

# --- OpenAI (optional, only read when PROVIDER=openai) ---
# MIRABOOK_OPENAI_API_KEY=sk-...
# gpt-5.6-terra balances quality and cost for per-block translation. Use
# gpt-5.6-luna to cut cost on long books, or gpt-6-astra for the best quality
# (note: it steers callers towards OpenAI's newer Responses API).
MIRABOOK_OPENAI_MODEL=gpt-5.6-terra
